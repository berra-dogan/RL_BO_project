#!/bin/bash
#PBS -N reward_group
#PBS -J 0-5
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=02:00:00

cd "$PBS_O_WORKDIR"

module purge
module load tools/prod
module load Python/3.11.3-GCCcore-12.3.0
source .venv/bin/activate

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

PYTHON=".venv/bin/python"
OUTPUT_ROOT="reward_finetune_reward_params"
GROUP_SIZE=10
START=$((PBS_ARRAY_INDEX * GROUP_SIZE))
END=$((START + GROUP_SIZE - 1))
TOTAL=$("$PYTHON" EARL_BO/run_reward_array.py --print-total)

echo "Array index: $PBS_ARRAY_INDEX"
echo "Running reward config indices: $START to $END"
echo "Total configs: $TOTAL"

for IDX in $(seq "$START" "$END"); do
  if [ "$IDX" -ge "$TOTAL" ]; then
    echo "Skipping IDX=$IDX because it is >= TOTAL=$TOTAL"
    continue
  fi

  echo "Running reward-array config $IDX"
  "$PYTHON" EARL_BO/run_reward_array.py \
    --index "$IDX" \
    --device cpu \
    --output-root "$OUTPUT_ROOT" \
    --skip-existing
done
