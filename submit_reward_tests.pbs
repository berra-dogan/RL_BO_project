#!/bin/bash
#PBS -N reward_test
#PBS -J 0-4
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:30:00

cd "$PBS_O_WORKDIR"

module purge
module load tools/prod
module load Python/3.11.3-GCCcore-12.3.0
source .venv/bin/activate

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

REWARDS=(earlbo snake log_improvement normalized_improvement optimistic_improvement)
REWARD="${REWARDS[$PBS_ARRAY_INDEX]}"

EXTRA_ARGS=""

if [ "$REWARD" = "snake" ]; then
  EXTRA_ARGS="--snake-path-cost-weight 0.01"
fi

if [ "$REWARD" = "optimistic_improvement" ]; then
  EXTRA_ARGS="--reward-param std_weight=0.2"
fi

OUTPUT_ROOT="reward_finetune_reward_params"
BEST_CONFIG="EARL_BO/${OUTPUT_ROOT}/${REWARD}/tuning/best_config.json"
if [ ! -f "$BEST_CONFIG" ]; then
  echo "Missing tuned config: $BEST_CONFIG" >&2
  exit 1
fi

echo "Array index: $PBS_ARRAY_INDEX"
echo "Reward mode: $REWARD"
echo "Extra args: $EXTRA_ARGS"

python EARL_BO/run_experiments.py \
  --mode test \
  --device cpu \
  --output-root "${OUTPUT_ROOT}/${REWARD}" \
  --reward-mode "$REWARD" \
  $EXTRA_ARGS \
  --skip-existing
