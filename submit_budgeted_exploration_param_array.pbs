#!/bin/bash
#PBS -N budgeted_array
#PBS -J 0-8
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=02:00:00

cd "$PBS_O_WORKDIR"

module purge
module load tools/prod
module load Python/3.11.3-GCCcore-12.3.0
source .venv/bin/activate

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

PYTHON=".venv/bin/python"
TOTAL=$("$PYTHON" EARL_BO/run_budgeted_exploration_tuning.py --print-total)

if [ "$PBS_ARRAY_INDEX" -ge "$TOTAL" ]; then
  echo "Skipping PBS_ARRAY_INDEX=$PBS_ARRAY_INDEX because it is >= TOTAL=$TOTAL"
  exit 0
fi

echo "Array index: $PBS_ARRAY_INDEX"
echo "Total configs: $TOTAL"
echo "Running one budgeted_exploration config"

"$PYTHON" EARL_BO/run_budgeted_exploration_tuning.py \
  --index "$PBS_ARRAY_INDEX" \
  --device cpu \
  --output-root budgeted_exploration_budget_grid \
  --skip-existing
