#!/bin/bash
#PBS -N lookahead_group
#PBS -J 0-2
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=01:00:00

cd "$PBS_O_WORKDIR"

module purge
module load tools/prod
module load Python/3.11.3-GCCcore-12.3.0
source .venv/bin/activate

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

PYTHON=".venv/bin/python"
OUTPUT_ROOT="../output/lookahead_budgeted_exploration_budget_grid"
GROUP_SIZE=3
START=$((PBS_ARRAY_INDEX * GROUP_SIZE))
END=$((START + GROUP_SIZE - 1))

TOTAL=$("$PYTHON" src/experiments/run_lookahead_budgeted_exploration_tuning.py --print-total)

echo "Array index: $PBS_ARRAY_INDEX"
echo "Running lookahead reward config indices: $START to $END"
echo "Total configs: $TOTAL"

for IDX in $(seq "$START" "$END"); do
  if [ "$IDX" -ge "$TOTAL" ]; then
    echo "Skipping IDX=$IDX because it is >= TOTAL=$TOTAL"
    continue
  fi

  echo "Running lookahead reward-array config $IDX"
  "$PYTHON" src/experiments/run_lookahead_budgeted_exploration_tuning.py \
    --index "$IDX" \
    --device cpu \
    --output-root "$OUTPUT_ROOT" \
    --skip-existing
done
