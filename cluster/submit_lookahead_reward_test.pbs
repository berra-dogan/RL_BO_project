#!/bin/bash
#PBS -N lookahead_test
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:30:00

cd "$PBS_O_WORKDIR"

module purge
module load tools/prod
module load Python/3.11.3-GCCcore-12.3.0
source .venv/bin/activate

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

OUTPUT_ROOT="../output/lookahead_budgeted_exploration_budget_grid/lookahead_budgeted_exploration"
BEST_CONFIG="output/lookahead_budgeted_exploration_budget_grid/lookahead_budgeted_exploration/tuning/best_config.json"

if [ ! -f "$BEST_CONFIG" ]; then
  echo "Missing tuned config: $BEST_CONFIG" >&2
  exit 1
fi

python src/experiments/run_one_reward_experiments.py \
  --mode test \
  --device cpu \
  --output-root "$OUTPUT_ROOT" \
  --reward-mode lookahead_budgeted_exploration \
  --skip-existing
